rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function instPath(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId);
    }
    function userPath(institutionId) {
      return /databases/$(database)/documents/institutions/$(institutionId)/users/$(request.auth.uid);
    }
    function member(institutionId) {
      return signedIn() && exists(userPath(institutionId))
        && get(userPath(institutionId)).data.status == 'active';
    }
    function role(institutionId, roleName) {
      return member(institutionId) && get(userPath(institutionId)).data.role == roleName;
    }
    function admin(institutionId) { return role(institutionId, 'admin'); }
    function faculty(institutionId) { return role(institutionId, 'faculty'); }
    function student(institutionId) { return role(institutionId, 'student'); }
    function staff(institutionId) { return admin(institutionId) || faculty(institutionId); }
    function sameIdentity(institutionId, uid) {
      return signedIn() && request.auth.uid == uid;
    }
    match /institutions/{institutionId} {
      allow get, list: if true;
      // Institutions and initial administrators are provisioned by trusted Admin SDK only.
      allow create, update, delete: if false;

      match /users/{uid} {
        allow get: if admin(institutionId) || sameIdentity(institutionId, uid);
        allow list: if admin(institutionId);
        allow create, delete: if admin(institutionId);
        allow update: if admin(institutionId) ||
          (sameIdentity(institutionId, uid)
           && resource.data.status == 'active'
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'designation'])
           && request.resource.data.role == resource.data.role
           && request.resource.data.status == resource.data.status);
      }

      match /join_requests/{uid} {
        allow read: if admin(institutionId) || sameIdentity(institutionId, uid);
        allow create: if sameIdentity(institutionId, uid)
          && request.auth.token.email_verified == true
          && request.resource.data.keys().hasOnly(['uid','email','name','requestedRole','status','createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.requestedRole in ['student','faculty']
          && request.resource.data.status == 'pending';
        allow update, delete: if admin(institutionId);
      }

      match /faculty/{record} {
        allow read: if staff(institutionId);
        allow write: if admin(institutionId);
      }
      match /students/{record} {
        allow read: if staff(institutionId);
        allow write: if admin(institutionId);
      }
      match /rooms/{record} {
        allow read: if staff(institutionId);
        allow write: if admin(institutionId);
      }
      match /sessions/{record} {
        allow read: if staff(institutionId);
        allow write: if admin(institutionId);
      }
      match /exam_events/{record} {
        allow read: if staff(institutionId);
        allow write: if admin(institutionId);
        match /{nested=**} {
          allow read: if staff(institutionId);
          allow write: if admin(institutionId);
        }
      }
      match /allocations/{record} {
        allow read: if staff(institutionId);
        allow write: if admin(institutionId);
      }
      match /leaves/{record} {
        allow read: if staff(institutionId);
        allow create: if admin(institutionId) ||
          (faculty(institutionId)
           && request.resource.data.facultyUid == request.auth.uid
           && request.resource.data.status == 'pending');
        allow update: if admin(institutionId);
        allow delete: if admin(institutionId);
      }
      match /student_views/{uid} {
        allow get: if admin(institutionId) ||
          (student(institutionId) && request.auth.uid == uid);
        allow list: if admin(institutionId);
        allow write: if admin(institutionId);
      }
    }
  }
}
